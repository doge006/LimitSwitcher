#include <winver.h>
#include "version.h"  /* written by build_windows.ps1 */
#ifndef VERSION_TEXT
#define VERSION_TEXT "0.0.0"
#endif
#ifndef VERSION_NUMBERS
#define VERSION_NUMBERS 0,0,0,0
#endif

#ifdef STATUS
#define NAME_TEXT "LimitSwitcher Status"
#define EXE_TEXT "LimitSwitcherStatus.exe"
#else
#define NAME_TEXT "LimitSwitcher"
#define EXE_TEXT "LimitSwitcher.exe"
#endif

1 ICON "account_switcher\\static\\assets\\switcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", NAME_TEXT
            VALUE "ProductName", "LimitSwitcher"
            VALUE "InternalName", NAME_TEXT
            VALUE "OriginalFilename", EXE_TEXT
            VALUE "FileVersion", VERSION_TEXT
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
