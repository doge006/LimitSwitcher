#include <winver.h>
/* No release number here, and the build is reproducible (/Brepro): the exe is the same file in every
   release, so an antivirus vendor that has cleared it once (Microsoft's machine-learning check took
   new builds for a trojan) needn't clear it again. Its number changes only when this launcher does. */
#define VERSION_TEXT "1.0"
#define VERSION_NUMBERS 1,0,0,0

1 ICON "account_switcher\\static\\assets\\switcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "doge006"
            VALUE "FileDescription", "LimitSwitcher"
            VALUE "LegalCopyright", "Copyright (c) doge006, MIT License"
            VALUE "ProductName", "LimitSwitcher"
            VALUE "InternalName", "LimitSwitcher"
            VALUE "OriginalFilename", "LimitSwitcher.exe"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
